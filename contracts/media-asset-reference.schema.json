{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf-04/media-asset-reference/0.1.0",
  "title": "CF-04 Media Asset Reference",
  "description": "Pre-activation draft contract. It identifies a binary asset without transferring the owning domain's content truth to CF-04.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "asset_id",
    "asset_version",
    "domain",
    "domain_object_id",
    "domain_object_version",
    "purpose",
    "privacy_class",
    "state",
    "policy_id",
    "policy_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "domain_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "domain_object_version": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "privacy_class": {
      "type": "string",
      "enum": ["C1", "C2", "C3", "C4", "C5"]
    },
    "state": {
      "type": "string",
      "enum": [
        "reserved",
        "uploading",
        "uploaded",
        "quarantined",
        "validating",
        "scanning",
        "processing",
        "ready",
        "rejected",
        "failed",
        "revoked",
        "held",
        "migration_pending",
        "deletion_pending",
        "deleted"
      ]
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "media_class", "detected_mime", "sha256"],
      "properties": {
        "media_class": {
          "type": "string",
          "enum": ["image", "audio", "video", "document", "attachment"]
        },
        "declared_mime": {
          "type": "string",
          "maxLength": 127
        },
        "detected_mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rights_version": {
          "type": "string",
          "maxLength": 64
        },
        "consent_version": {
          "type": "string",
          "maxLength": 64
        },
        "retention_rule_id": {
          "type": "string",
          "maxLength": 64
        },
        "hold_active": {
          "type": "boolean"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "enum": ["reserved", "uploading"]
            }
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["source"]
      }
    }
  ]
}
