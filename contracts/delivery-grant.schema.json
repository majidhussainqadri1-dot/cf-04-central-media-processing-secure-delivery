{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf-04/delivery-grant/1.3.1",
  "title": "CF-04 Delivery Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "grant_id",
    "asset_id",
    "owner_domain",
    "owner_object",
    "object_version",
    "privacy_class",
    "expires_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.3.1"
    },
    "grant_id": {
      "type": "string",
      "minLength": 8
    },
    "asset_id": {
      "type": "string",
      "minLength": 8
    },
    "owner_domain": {
      "type": "string"
    },
    "owner_object": {
      "type": "string"
    },
    "object_version": {
      "type": "integer",
      "minimum": 1
    },
    "privacy_class": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    "expires_at": {
      "type": "integer"
    },
    "audience_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
