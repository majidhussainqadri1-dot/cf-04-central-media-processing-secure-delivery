{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf-04/download-session/1.3.1",
  "title": "Download Session",
  "type": "object",
  "required": [
    "contract_version",
    "id",
    "user_id",
    "asset_id",
    "status",
    "progress"
  ],
  "properties": {
    "contract_version": {
      "const": "1.3.1"
    },
    "id": {
      "type": "string"
    },
    "user_id": {
      "type": "integer",
      "minimum": 1
    },
    "asset_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "downloading",
        "paused",
        "failed",
        "complete",
        "cancelled"
      ]
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
