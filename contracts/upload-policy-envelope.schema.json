{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf-04/upload-policy-envelope/1.3.1",
  "title": "CF-04 Upload Policy Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "policy_id",
    "policy_version",
    "domain",
    "purpose",
    "privacy_class",
    "media_class",
    "max_size_bytes",
    "required_scans"
  ],
  "properties": {
    "contract_version": {
      "const": "1.3.1"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "privacy_class": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    "media_class": {
      "enum": [
        "image",
        "audio",
        "video",
        "document",
        "archive"
      ]
    },
    "max_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "required_scans": {
      "type": "array",
      "contains": {
        "const": "malware"
      }
    }
  }
}
